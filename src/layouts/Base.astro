---
import "../styles/global.css";
import "../styles/motion.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  titulo: string;
  descripcion: string;
  /** Se usa para marcar el link activo del header. */
  seccion?: "inicio" | "carta" | "retail" | "volumen" | "alianzas";
}

const { titulo, descripcion, seccion } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />

    <meta name="theme-color" content="#f8fafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1619" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
    />

    {/*
      Contrato de fallo de la capa de movimiento. Va inline y ANTES de cualquier
      hoja que pre-oculte algo: agrega `html.js` para que motion.css pueda
      esconder el hero, y arma un timeout que lo vuelve a quitar. initMotion()
      cancela ese timeout. Si el bundle nunca carga, revienta o lo bloquean, la
      página se destapa sola a los 2.2s.

      Bajo prefers-reduced-motion la clase no se agrega nunca, así que no se
      oculta nada en ningún momento.
    */}
    <script is:inline>
      (function () {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.documentElement.classList.add("js");
        window.__motionFallback = setTimeout(function () {
          document.documentElement.classList.remove("js");
        }, 2200);
      })();
    </script>
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:rounded-full focus:bg-berry focus:px-5 focus:py-3 focus:text-sm focus:text-white"
    >
      Saltar al contenido
    </a>

    <div class="progress-bar text-berry"></div>

    <Header seccion={seccion} />

    <main id="contenido" class="overflow-x-clip">
      <slot />
    </main>

    <Footer />

    <script>
      import { initMotion, destroyMotion } from "../lib/motion.js";

      initMotion();
      // View Transitions entre documentos: el <head> sobrevive pero el DOM se
      // reemplaza. Sin el destroy, ScrollTrigger acumula triggers muertos y
      // SplitText deja el DOM despedazado de la página anterior.
      document.addEventListener("astro:after-swap", initMotion);
      document.addEventListener("astro:before-swap", destroyMotion);
    </script>
  </body>
</html>
