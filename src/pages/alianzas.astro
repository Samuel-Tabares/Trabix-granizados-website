---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { waLink } from "../lib/whatsapp";
import emprendimiento from "../assets/real-life/emprendimiento-01.jpg";

/*
  ADVERTENCIA DE CONTENIDO — leer ROADMAP.md antes de tocar esta página.

  1. El modelo de inversión está PAUSADO: no hay onboarding detrás de quien
     llegue por acá. La página capta interés, no promete arranque inmediato.
  2. El programa de embajadores no está corriendo: ningún CTA puede depender de
     que existan embajadores activos.
  3. Nunca mencionar el costo de producción (real ni aproximado) ni ningún
     porcentaje de rentabilidad/margen. Decisión de Samuel del 2026-09-24: la
     versión anterior decía "costo de producción menor a $2.500 por unidad" y
     "hasta 280% de rentabilidad" — ambos datos se acercan demasiado a lo que
     `MODELO NEGOCIO/` marca como confidencial (costo real ≈$2.000, distinto
     del costo percibido que se le vende al vendedor). Si se agrega contenido
     nuevo a esta página, no reintroducir ninguna cifra de costo o margen.
*/

const CORREO = "trabixgranizados@gmail.com";

const beneficios = [
  {
    t: "Recuperas inversión",
    d: "Casi siempre en la primera tanda.",
  },
  {
    t: "Acceso a precio proveedor",
    d: "Compras al precio más bajo que maneja la marca, sin intermediarios.",
  },
  {
    t: "Desde $20.000",
    d: "Para entrar, y te prestamos el dinero.",
  },
];

const datos = ["Nombre", "Ciudad", "Teléfono de contacto", "Monto disponible para comenzar"];

const asunto = "Quiero emprender con Trabix";
const cuerpo = [
  "Hola, me interesa emprender con Trabix. Estos son mis datos:",
  "",
  "Nombre:",
  "Ciudad:",
  "Teléfono de contacto:",
  "Monto disponible para comenzar:",
].join("\n");
const mailto = `mailto:${CORREO}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
---

<Base
  titulo="Emprende con Trabix"
  descripcion="Empieza a vender granizados Trabix desde $20.000. Tú vendes, Trabix sostiene almacenamiento, congelamiento, logística y contabilidad."
  seccion="alianzas"
>
  <!-- ============================ HERO ============================ -->
  <section data-hero class="px-5 pt-32 pb-16 sm:pt-40">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow hero__eyebrow">Emprende con Trabix</p>
        <h1 class="display hero__title mt-5 text-[2.9rem] sm:text-7xl">
          Empieza pequeño,<br />piensa en grande.
        </h1>
        <p class="lead hero__lead mt-6 text-base sm:text-lg">
          Puedes empezar desde <span class="text-fg">$20.000</span>. Tú te concentras en vender
          —digital, por recomendación, en persona, al detal o al por mayor— y Trabix sostiene
          lo pesado de la operación: almacenamiento masivo, congelamiento masivo, logística
          completa, y el registro financiero y contable.
        </p>

        <div class="hero__actions mt-8 flex flex-wrap gap-3">
          <a href={mailto} class="btn btn--primary">
            Escribir al correo
            <span class="btn__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
          <a href={waLink("alianzas-info")} class="btn btn--ghost">
            Preguntar por WhatsApp
            <span class="btn__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        </div>

        <p class="hero__badge mt-6 text-sm text-fg-muted">
          No necesitas experiencia ni hoja de vida. Solo ganas de generar dinero.
        </p>
      </div>

      <div class="hero__stat">
        <div class="aspect-[4/5] overflow-hidden rounded-[var(--radius-surface)] border border-hairline">
          <Image
            src={emprendimiento}
            alt="Emprendedor vendiendo granizados Trabix"
            widths={[360, 600, 900]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= BENEFICIOS ========================= -->
  <section class="px-5 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <h2 class="display text-3xl sm:text-5xl" data-split>Qué obtienes</h2>

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-surface)] border border-hairline bg-hairline sm:grid-cols-3"
        data-reveal="stagger"
      >
        {
          beneficios.map((b) => (
            <div class="flex flex-col gap-2 bg-bg p-7">
              <h3 class="text-xl font-medium tracking-tight">{b.t}</h3>
              <p class="text-sm text-fg-muted">{b.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== FONDO DE RECOMPENSAS ==================== -->
  <section class="px-5 pb-20 sm:pb-28">
    <div class="mx-auto max-w-6xl">
      <div
        class="flex flex-col gap-3 rounded-[var(--radius-surface)] border border-hairline p-8 sm:p-12"
        data-reveal
      >
        <p class="eyebrow">Para que te antojes</p>
        <p class="display text-2xl sm:text-4xl">
          Fondo de recompensas a los mejores vendedores: premios desde $25.000 en efectivo.
        </p>
        <p class="lead mt-2">
          La marca ya tiene aliados, presencia constante en eventos y llega donde un granizado
          tradicional no llega.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================== CÓMO ENTRAR ======================== -->
  <section class="px-5 pb-24 sm:pb-32">
    <div class="mx-auto max-w-3xl">
      <h2 class="display text-3xl sm:text-5xl" data-split>Cómo se empieza</h2>
      <p class="lead mt-6">
        Prepara el primer contacto con los cuatro datos mínimos. Escríbenos al correo
        <span class="text-fg">{CORREO}</span> con:
      </p>

      <ol
        class="mt-8 divide-y divide-hairline border-y border-hairline"
        data-reveal="stagger"
      >
        {
          datos.map((d, i) => (
            <li class="flex items-baseline gap-4 py-5">
              <span class="font-mono text-xs text-berry">{String(i + 1).padStart(2, "0")}</span>
              <span class="text-base">{d}</span>
            </li>
          ))
        }
      </ol>

      <a href={mailto} class="btn btn--primary mt-10">
        Preparar correo
        <span class="btn__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </a>
    </div>
  </section>
</Base>
